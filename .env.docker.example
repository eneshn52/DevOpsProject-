# Used by Compose via --env-file; not loaded by native Django.
DJANGO_SECRET_KEY=replace-with-generated-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
WEB_PORT=8000
DB_NAME=devops_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_BIND_ADDRESS=0.0.0.0
POSTGRES_CONTAINER_NAME=devops_postgres
POSTGRES_VOLUME_NAME=devopsproject-_postgres_data
OLLAMA_DEFAULT_URL=http://host.docker.internal:11434
OLLAMA_LOOPBACK_HOST=host.docker.internal
OLLAMA_REQUEST_TIMEOUT=180
