# Database Configuration
USE_SQLITE=False
DB_NAME=devops_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONNECT_TIMEOUT=5

# Shared workspace access and model relay
WORKSPACE_ALLOW_LOCAL_ACCESS=True
OLLAMA_DEFAULT_URL=http://localhost:11434
# Leave empty for native Python; Docker sets host.docker.internal separately.
OLLAMA_LOOPBACK_HOST=
OLLAMA_REQUEST_TIMEOUT=180
